FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    location    "system";
    object      controlDict;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

application     hybridPorousPimpleFoam;

startFrom       latestTime;

startTime       0;

stopAt          endTime;//writeNow;//endTime; 

endTime         100;

deltaT          0.005;

writeControl    timeStep; //adjustableRunTime;

writeInterval   100;

purgeWrite      0;

writeFormat     ascii;

writePrecision  6;

writeCompression uncompressed;// changed from uncompressed to  compressed Tue Feb 11 10:45:34 PM PST 2025

timeFormat      general;

timePrecision   6;

runTimeModifiable yes;

adjustTimeStep  yes;

maxCo           0.5;
maxAlphaCo      0.5;

functions
{
#includeFunc  residuals
}


