FoamFile
{
    format      ascii;
    class       dictionary;
    location    "system";
    object      snappyHexMeshDict;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

#includeEtc "caseDicts/mesh/generation/snappyHexMeshDict.cfg"

castellatedMesh on;

snap            off;

addLayers       off;

geometry
{
    SolidGrain
    {
        type triSurfaceMesh;
        file "Solid_T6_T9_T10_T12_T13_Finalized_Scaled.stl";
    }
}

castellatedMeshControls
{
    features
    (
    );

    refinementSurfaces
    {
        SolidGrain
        {
            level (0 0);
            patchInfo { type wall; }
        }
    }

    // delete "-disabled" below to enable refinementRegions
    refinementRegions-disabled
    {
        <surface>
        {
            mode    inside;
            level   2;
        }
    }

    insidePoint (0.0005 0.0014 2.61262e-05);
    nCellsBetweenLevels 3;
}

snapControls
{
    explicitFeatureSnap    off;
    implicitFeatureSnap    on;
}

addLayersControls
{
    layers
    {
        "SolidGrain.*" { nSurfaceLayers 0; }
    }

    relativeSizes       on; // off, usually with firstLayerThickness
    expansionRatio      1.2;
    finalLayerThickness 0.5;
    minThickness        0.001;
    firstLayerThickness-disabled 0;
    maxThicknessToMedialRatio-disabled 0.3;
}

// delete "-disabled" to output mesh data, e.g. for layers
writeFlags-disabled
(
    scalarLevels
    layerSets
    layerFields
);

mergeTolerance 1e-6;

// ************************************************************************* //
